#--------------------------------------------------------------------
# Personal Investment Portfolio Tracker - Environment Configuration
# Copy this file to .env and adjust your settings, or use the setup
# wizard at http://localhost/Portfolio/public/install.php
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APPLICATION
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/Portfolio/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.defaultLocale = 'en'
app.appTimezone = 'Asia/Kolkata'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = investment_portfolio
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION
# Generate a 32-byte key: php spark key:generate --show
# Or use random hex string: hex2bin:<64-character-hex>
#--------------------------------------------------------------------
encryption.key = hex2bin:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'portfolio_session'
session.expiration = 7200
# session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# LOGGER
# 0 = Disables, 1 = Error, 2 = Debug, 3 = Info, 4 = All Messages
#--------------------------------------------------------------------
logger.threshold = 1

